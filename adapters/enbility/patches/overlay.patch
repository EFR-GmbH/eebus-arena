+// ArenaListenerStatus observes the existing listener without changing its lifecycle.
+func (h *Hub) ArenaListenerStatus() map[string]any {
+	h.muxPairingListener.RLock()
+	listener := h.activePairingListener
+	h.muxPairingListener.RUnlock()
+	if listener == nil {
+		return map[string]any{"active": false}
+	}
+	status := listener.GetListenerStatus()
+	result := map[string]any{"active": status.Active, "requestsSeen": status.RequestsSeen, "startTime": status.StartTime, "lastRequest": status.LastRequest}
+	if status.Error != nil {
+		result["error"] = status.Error.Error()
+	}
+	return result
+}
