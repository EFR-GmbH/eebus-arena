+func (h *Hub) arenaServeTLS() error {
+	network := "tcp"
+	switch api.ArenaNetworkMode {
+	case "ipv4", "":
+		network = "tcp4"
+	case "ipv6":
+		network = "tcp6"
+	}
+	listener, err := net.Listen(network, h.httpServer.Addr)
+	if err != nil {
+		return err
+	}
+	return h.httpServer.ServeTLS(listener, "", "")
+}
