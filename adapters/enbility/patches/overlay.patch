+func arenaIPTraffic() zeroconf.IPType {
+	switch api.ArenaNetworkMode {
+	case "ipv4", "":
+		return zeroconf.IPv4
+	case "ipv6":
+		return zeroconf.IPv6
+	default:
+		return zeroconf.IPv4AndIPv6
+	}
+}
+func arenaAddresses(entry *zeroconf.ServiceEntry) []net.IP {
+	switch api.ArenaNetworkMode {
+	case "ipv4", "":
+		return entry.AddrIPv4
+	case "ipv6":
+		return entry.AddrIPv6
+	default:
+		return append(append([]net.IP(nil), entry.AddrIPv4...), entry.AddrIPv6...)
+	}
+}
