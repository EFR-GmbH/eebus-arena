+// ArenaSetInterval is a control hook; it does not supply use-case state logic.
+func (c *HeartbeatManager) ArenaSetInterval(interval time.Duration) error {
+	if interval < time.Second {
+		return fmt.Errorf("interval must be at least one second")
+	}
+	running := c.IsHeartbeatRunning()
+	c.StopHeartbeat()
+	c.mux.Lock()
+	c.heartBeatTimeout = model.NewDurationType(interval)
+	c.mux.Unlock()
+	if running {
+		return c.StartHeartbeat()
+	}
+	return nil
+}
+
+var ArenaTimeScale int64 = 1
