+file(GLOB ARENA_HEMS examples/hems/*.c)
+list(FILTER ARENA_HEMS EXCLUDE REGEX "/main.c$")
+file(GLOB ARENA_CS examples/heat_pump/*.c)
+list(FILTER ARENA_CS EXCLUDE REGEX "/main.c$")
+add_executable(arena-node arena/main.c arena/monitoring.c ${ARENA_HEMS} ${ARENA_CS})
+target_link_libraries(arena-node PRIVATE openeebus PkgConfig::CJSON pthread m)
+target_include_directories(arena-node PRIVATE ${CMAKE_CURRENT_SOURCE_DIR}/arena)
