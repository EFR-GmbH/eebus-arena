{
  "name": "EEBUS Arena",
  "build": {
    "dockerfile": "../docker/dev.Dockerfile",
    "context": ".."
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",
  "containerUser": "vscode",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "overrideCommand": true,
  "init": true,
  "containerEnv": {
    "ARENA_DEV_CONTAINER": "1",
    "GOCACHE": "/home/vscode/.cache/go-build",
    "GOMODCACHE": "/home/vscode/.cache/go-modules",
    "RUFF_CACHE_DIR": "/home/vscode/.cache/ruff",
    "GRADLE_USER_HOME": "/home/vscode/.gradle",
    "PYTHONDONTWRITEBYTECODE": "1"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "golang.go",
        "ms-vscode.cpptools",
        "redhat.java"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python3",
        "ruff.path": ["/usr/local/bin/ruff"],
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        },
        "[go]": {
          "editor.defaultFormatter": "golang.go"
        },
        "[c]": {
          "editor.defaultFormatter": "ms-vscode.cpptools"
        },
        "C_Cpp.clang_format_path": "/usr/bin/clang-format-14",
        "C_Cpp.clang_format_style": "file",
        "java.jdt.ls.java.home": "/opt/java/openjdk",
        "java.format.enabled": false
      }
    }
  }
}
